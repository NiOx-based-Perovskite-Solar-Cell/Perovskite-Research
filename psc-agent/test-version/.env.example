# Copy to .env (same folder) and fill in. .env is git-ignored. Real environment variables win over this file.
# One key per provider you use (--provider openrouter | gemini | ollama; claude-code needs none).
OPENROUTER_API_KEY=
# Google AI Studio key (also read as GEMINI_API_KEY or GOOGLE_API_KEY)
GOOGLE_GEMINI_API_KEY=
# Ollama Cloud key (also read as OLLAMA_API_KEY)
OLLAMA_CLOUD_API_KEY=
# Agent server (the SI agent with your own Chrome, outside Docker): a secret both sides share. `python -m psc_agent agent-server`
# prints one when this is empty. docker-compose points the web app at http://host.docker.internal:5100 by itself;
# set AGENT_SERVER_URL here only when the web app runs outside Docker (http://127.0.0.1:5100) or the server uses another port.
AGENT_SERVER_TOKEN=
